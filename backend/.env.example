# Django Secret Key (generate a secure one for production)
SECRET_KEY=django-insecure-zivio-secret-key-change-me

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated hosts)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=zivio_db
DB_USER=zivio_user
DB_PASSWORD=zivio_pass
DB_HOST=localhost
DB_PORT=5432

# Clerk JWKS URL for token validation
# Format: https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json
